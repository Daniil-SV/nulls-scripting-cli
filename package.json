{
	"name": "nulls-scripting-cli",
	"version": "0.1.0",
	"description": "CLI and TypeScript API for Null's Brawl scripting development",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js",
			"default": "./dist/config.js"
		},
		"./url": {
			"types": "./dist/url.d.ts",
			"import": "./dist/url.js",
			"default": "./dist/url.js"
		},
		"./api": {
			"types": "./dist/api/scripting/index.d.ts",
			"import": "./dist/api/scripting/index.js",
			"default": "./dist/api/scripting/index.js"
		},
		"./api/scripting": {
			"types": "./dist/api/scripting/index.d.ts",
			"import": "./dist/api/scripting/index.js",
			"default": "./dist/api/scripting/index.js"
		},
		"./api/connect": {
			"types": "./dist/api/connect/index.d.ts",
			"import": "./dist/api/connect/index.js",
			"default": "./dist/api/connect/index.js"
		},
		"./api/client": {
			"types": "./dist/api/client.d.ts",
			"import": "./dist/api/client.js",
			"default": "./dist/api/client.js"
		},
		"./shared/deeplink": {
			"types": "./dist/shared/deeplink.d.ts",
			"import": "./dist/shared/deeplink.js",
			"default": "./dist/shared/deeplink.js"
		},
		"./shared/auth": {
			"types": "./dist/shared/auth.d.ts",
			"import": "./dist/shared/auth.js",
			"default": "./dist/shared/auth.js"
		},
		"./shared/scripts": {
			"types": "./dist/shared/scripts.d.ts",
			"import": "./dist/shared/scripts.js",
			"default": "./dist/shared/scripts.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"nbs": "./bin/run.js"
	},
	"files": [
		"bin/run.js",
		"bin/run.cmd",
		"dist",
		"oclif.manifest.json"
	],
	"scripts": {
		"generate:api": "pnpm generate:scripting && pnpm generate:connect",
		"generate:scripting": "pnpm --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 dlx openapi-typescript schema/openapi.yaml -o src/api/scripting/schema.ts",
		"generate:connect": "pnpm --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 dlx openapi-typescript schema/openapi.connect.yaml -o src/api/connect/schema.ts",
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json --noEmit --composite false --incremental false",
		"prepack": "pnpm run build && oclif manifest",
		"start": "node ./bin/run.js",
		"start:dev": "pnpm build && tsx bin/dev.js"
	},
	"keywords": [
		"nulls",
		"nulls-brawl",
		"brawl-stars",
		"scripting",
		"cli",
		"typescript",
		"api"
	],
	"author": "Daniil SV and Nulls Community",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Daniil-SV/nulls-scripting-cli.git"
	},
	"homepage": "https://github.com/Daniil-SV/nulls-scripting-cli#readme",
	"bugs": {
		"url": "https://github.com/Daniil-SV/nulls-scripting-cli/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.9.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.16.1",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/node": "^26.6.6",
		"@types/uuid-validate": "^0.0.3",
		"@types/which": "^3.0.4",
		"oclif": "^6.0.15",
		"openapi-typescript": "^7.13.0",
		"tsc-alias": "^1.9.9",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@bomb.sh/tty": "^0.10.0",
		"@clack/prompts": "^1.8.1",
		"@oclif/core": "^5.1.10",
		"@oclif/plugin-help": "^7.0.6",
		"@parcel/watcher": "^2.6.0",
		"@yume-chan/adb": "^2.6.4",
		"@yume-chan/adb-server-node-tcp": "^2.5.2",
		"conf": "^16.0.0",
		"lilconfig": "^3.1.4",
		"node-machine-id": "^1.1.12",
		"open": "^11.0.4",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript-helpers": "^0.1.0",
		"uuid-validate": "^0.0.3",
		"which": "^6.0.1"
	},
	"oclif": {
		"bin": "nbs",
		"commands": "./dist/commands",
		"plugins": [
			"@oclif/plugin-help"
		],
		"dirname": "nulls-scripting-cli",
		"topicSeparator": " ",
		"topics": {
			"content": {
				"description": "manage scripts content"
			}
		},
		"hooks": {
			"init": "./dist/hooks/init/init"
		}
	}
}
